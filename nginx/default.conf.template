upstream registry_backend {
    server ${REGISTRY_UPSTREAM};
    keepalive 8;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Runtime config for the SPA; the only deploy-time values it needs.
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-cache";
        return 200 '{"registryPublicUrl":"${REGISTRY_PUBLIC_URL}"}';
    }

    # Vite emits content-hashed files under /assets/: cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA routes; index.html must revalidate so new builds are picked up.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    location /v2/ {
        # Read-only: GET implies HEAD. Everything else gets 403.
        limit_except GET {
            deny all;
        }

        # No URI part: the request URI is passed through unmodified.
        proxy_pass http://registry_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Mode A: Authorization from the browser is forwarded as-is (nginx default).
        # Mode B only: uncomment both lines; see the Authentication section.
        # proxy_set_header Authorization "Basic ${REGISTRY_BASIC_B64}";
        # proxy_hide_header WWW-Authenticate;

        proxy_read_timeout 30s;
    }
}
